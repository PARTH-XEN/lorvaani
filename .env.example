# ==============================================================================
# LORVANI — AI PROVIDER CONFIGURATION
# Copy this file to `.env` and supply your API keys.
# NEVER commit your real `.env` file to source control!
# ==============================================================================

# Primary Text Generation Provider: Google Gemini
# Obtain a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Secondary Text Generation Provider: Groq
# Obtain a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Image Generation Provider: Pollinations.ai
# Free, open access (no key required for base tier)
# Optional Pro Key from: https://enter.pollinations.ai/
POLLINATIONS_API_KEY=
POLLINATIONS_DEFAULT_MODEL=flux

# Cloudflare Workers AI (Optional Edge Provider)
# Obtain Account ID and Token at: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face Inference API (Optional)
# Obtain Token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# App Provider Behavior
# Mode: mock | auto | gemini | groq
AI_PROVIDER_MODE=auto

# Cache Expiration (in minutes)
AI_CACHE_TTL_MINUTES=60

